             aria-label="<?php echo $escape($translate('QR code for setting up two-factor authentication')); ?>"></div>

        <noscript>
            <p class="error"><?php echo $translate('JavaScript is required to draw the QR code. Use the setup key below instead.'); ?></p>
        </noscript>

        <details class="totp-manual-entry">
            <summary><?php echo $translate('Can’t scan? Enter this key by hand'); ?></summary>
            <p>
                <code id="totp-secret"><?php echo $escape(chunk_split((string) $secret, 4, ' ')); ?></code>
            </p>
            <p class="totp-manual-hint">
                <?php echo $translate('Type: time-based · Digits: 6 · Interval: 30 seconds · Algorithm: SHA1'); ?>
            </p>
