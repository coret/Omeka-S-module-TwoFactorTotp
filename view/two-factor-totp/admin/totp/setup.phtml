?>
<?php echo $this->pageTitle($translate('Set up two-factor authentication'), 1, $translate('Users')); ?>

<?php if ($isForced): ?>
<div class="messages">
    <ul class="messages"><li class="warning"><?php
        echo $translate('Two-factor authentication is required for your role. You cannot use the admin interface until you finish this.');
    ?></li></ul>
</div>
<?php endif; ?>

<div class="two-factor-setup">

    <section class="setup-step">
        <h3><?php echo $translate('1. Install an authenticator app'); ?></h3>
        <p><?php echo $translate('Any TOTP app works — for example Google Authenticator, Aegis, FreeOTP, 1Password or Bitwarden.'); ?></p>
    </section>

    <section class="setup-step">
        <h3><?php echo $translate('2. Scan this code'); ?></h3>

        <div id="totp-qrcode"
             data-uri="<?php echo $escape($provisioningUri); ?>"
