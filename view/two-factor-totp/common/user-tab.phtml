<?php
/**
 * The "Two-factor authentication" section on the user edit page.
 *
 * Rendered from Module::addUserSection() into the view.edit.form.after event.
 * It sits *outside* the surrounding form's inputs on purpose: enrollment is a
 * multi-step flow of its own, not something to save along with a display name.
 *
 * Two variables carry the distinction that matters here. $hasAnyFactor is
 * "does this account have a second factor at all", which is what the status
 * line and the recovery-code count are about; $isEnabled is "does it have TOTP
 * specifically", which is all the TOTP setup and disable links should depend
 * on. Conflating them is what previously hid passkeys from everyone who had
 * not already enrolled in TOTP.
 *
 * @var \Omeka\Api\Representation\UserRepresentation $user
 * @var \Omeka\Entity\User $userEntity
 * @var bool $isSelf
 * @var bool $isEnabled           TOTP specifically
 * @var bool $hasAnyFactor        TOTP, a passkey, or anything else registered
 * @var bool $isForced
 * @var int $recoveryCodesRemaining
 * @var int $lowWaterMark
 * @var int $deviceCount
 * @var int $passkeyCount
 * @var bool $passkeysAvailable
 * @var bool $trustedDevicesEnabled
 * @var bool $canReset
 */
$translate = $this->plugin('translate');
?>
<fieldset id="two-factor-totp" class="section">

<?php if ($isSelf): ?>

    <?php if ($hasAnyFactor): ?>

        <p class="totp-status totp-status-on">
            <strong><?php echo $translate('Two-factor authentication is enabled.'); ?></strong>
            <?php if ($isEnabled): ?>
                <?php echo $translate('You are asked for a code from your authenticator app when you log in.'); ?>
            <?php else: ?>
                <?php echo $translate('You are asked for your passkey when you log in.'); ?>
            <?php endif; ?>
        </p>

        <?php if ($recoveryCodesRemaining <= $lowWaterMark): ?>
        <p class="totp-warning">
            <?php echo sprintf(
                $translate('Only %d recovery codes left. Generate a new set so you are not locked out if you lose your phone.'),
                $recoveryCodesRemaining
            ); ?>
        </p>
        <?php else: ?>
        <p><?php echo sprintf($translate('%d recovery codes remaining.'), $recoveryCodesRemaining); ?></p>
        <?php endif; ?>

        <?php if ($trustedDevicesEnabled): ?>
        <p><?php echo sprintf($translate('%d trusted devices.'), $deviceCount); ?></p>
        <?php endif; ?>

        <p class="totp-actions">
            <?php echo $this->hyperlink(
                $translate('Generate new recovery codes'),
                $this->url('admin/two-factor', ['action' => 'recovery-codes']),
                ['class' => 'button']
            ); ?>
            <?php if (!$isEnabled): ?>
            <?php echo $this->hyperlink(
                $translate('Enable two-factor authentication'),
                $this->url('admin/two-factor', ['action' => 'setup']),
                ['class' => 'button']
            ); ?>
            <?php endif; ?>
            <?php if ($passkeysAvailable): ?>
            <?php echo $this->hyperlink(
                sprintf($translate('Passkeys (%d)'), $passkeyCount),
                $this->url('admin/two-factor', ['action' => 'passkeys']),
                ['class' => 'button']
            ); ?>
            <?php endif; ?>
            <?php if ($trustedDevicesEnabled): ?>
            <?php echo $this->hyperlink(
                $translate('Manage trusted devices'),
                $this->url('admin/two-factor', ['action' => 'devices']),
                ['class' => 'button']
            ); ?>
            <?php endif; ?>
            <?php if ($isEnabled && !$isForced): ?>
            <?php echo $this->hyperlink(
                $translate('Disable two-factor authentication'),
                $this->url('admin/two-factor', ['action' => 'disable']),
                ['class' => 'button red']
            ); ?>
            <?php endif; ?>
        </p>

        <?php if ($isForced): ?>
        <p class="totp-note"><?php echo $translate('Two-factor authentication is required for your role, so it cannot be turned off.'); ?></p>
        <?php endif; ?>

    <?php else: ?>

        <p class="totp-status totp-status-off">
            <strong><?php echo $translate('Two-factor authentication is not enabled.'); ?></strong>
            <?php echo $translate('Add a second step to your login — a code from an authenticator app on your phone, or a passkey such as a hardware key, Touch ID or Windows Hello — so a stolen password is not enough on its own.'); ?>
        </p>

        <?php if ($isForced): ?>
        <p class="totp-warning"><?php echo $translate('It is required for your role — you will be asked to set it up on your next request.'); ?></p>
        <?php endif; ?>

        <p class="totp-actions">
            <?php echo $this->hyperlink(
                $translate('Enable two-factor authentication'),
                $this->url('admin/two-factor', ['action' => 'setup']),
                ['class' => 'button']
            ); ?>
            <?php if ($passkeysAvailable): ?>
            <?php echo $this->hyperlink(
                sprintf($translate('Passkeys (%d)'), $passkeyCount),
                $this->url('admin/two-factor', ['action' => 'passkeys']),
                ['class' => 'button']
            ); ?>
            <?php endif; ?>
        </p>

    <?php endif; ?>

<?php else: ?>

    <p class="totp-status">
        <?php if ($hasAnyFactor): ?>
            <strong><?php echo $translate('Two-factor authentication is enabled for this user.'); ?></strong>
        <?php else: ?>
            <strong><?php echo $translate('Two-factor authentication is not enabled for this user.'); ?></strong>
        <?php endif; ?>
    </p>

    <p class="totp-note">
        <?php echo $translate('Only the account holder can set this up — nobody else can see or change their secret.'); ?>
    </p>

    <?php if ($canReset && $hasAnyFactor): ?>
    <p class="totp-actions">
        <?php echo $this->hyperlink(
            $translate('Reset two-factor authentication'),
            $this->url('admin/two-factor', ['action' => 'reset'], ['query' => ['user_id' => $user->id()]]),
            ['class' => 'button red']
        ); ?>
    </p>
    <p class="totp-note">
        <?php echo $translate('Use this when the person has lost their phone and their recovery codes. They will be emailed, and the reset is logged.'); ?>
    </p>
    <?php endif; ?>

<?php endif; ?>

<style>
#two-factor-totp .totp-status { margin-bottom: 1em; }
#two-factor-totp .totp-warning { color: #a33; font-weight: bold; }
#two-factor-totp .totp-note { color: #666; font-size: .9em; }
#two-factor-totp .totp-actions { margin: 1.2em 0; display: flex; flex-wrap: wrap; gap: .5em; }
</style>

</fieldset>
