msgstr "The name shown next to the account in the authenticator app. Leave empty to use the installation title."

msgid "Require two-factor authentication for these roles"
msgstr "Require two-factor authentication for these roles"

msgid "Users with a selected role must set up two-factor authentication before they can use the admin interface. Existing sessions are not affected."
msgstr "Users with a selected role must set up two-factor authentication before they can use the admin interface. Existing sessions are not affected."

msgid "Remember a device for (days)"
msgstr "Remember a device for (days)"

msgid "How long a device stays trusted after the user ticks \"remember this device\". Set to 0 to remove the option entirely."
msgstr "How long a device stays trusted after the user ticks \"remember this device\". Set to 0 to remove the option entirely."

msgid "Accepted time steps either side"
msgstr "Accepted time steps either side"

msgid "How much clock drift between server and phone to tolerate, in 30-second steps. 1 is the usual value; raising it widens the window in which a code stays valid."
msgstr "How much clock drift between server and phone to tolerate, in 30-second steps. 1 is the usual value; raising it widens the window in which a code stays valid."

msgid "Time allowed to enter the code (seconds)"
msgstr "Time allowed to enter the code (seconds)"

msgid "How long a password-verified login may wait at the code screen before it is discarded."
msgstr "How long a password-verified login may wait at the code screen before it is discarded."

msgid "Wrong codes allowed per login"
msgstr "Wrong codes allowed per login"

msgid "After this many wrong codes the login is discarded and the user starts again from the password screen."
msgstr "After this many wrong codes the login is discarded and the user starts again from the password screen."

